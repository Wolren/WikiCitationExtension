{
  "name": "wikifix-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "vitest run -c vitest.api.config.ts",
    "test:all": "vitest run -c vitest.all.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "ci": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "adm-zip": "0.6.0",
    "archiver": "8.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "jsdom": "30.0.0",
    "jszip": "3.10.1",
    "tsx": "4.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "isbn3": "2.0.9"
  }
}
