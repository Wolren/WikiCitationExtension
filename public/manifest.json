{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "WikiCitationExtension",
  "version": "1.0.0",
  "description": "Fix English Wikipedia citations — expand metadata, clean up parameters, enrich identifiers. English Wikipedia only.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://en.wikipedia.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WikiCitationExtension"
  },
  "content_scripts": [
    {
      "matches": ["https://en.wikipedia.org/*"],
      "js": ["browser-polyfill.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wikifix@wolren.dev",
      "strict_min_version": "115.0"
    }
  }
}
